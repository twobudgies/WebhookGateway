# Copy to .env to change defaults. Everything is optional.
# POSTGRES_PASSWORD=change-me            # database password (the database is not published outside the compose network)
# WG_ADMIN_KEY=wgadmin_choose_a_long_random_value
# WG_SECRET_KEY=                         # base64 of 32 random bytes; encrypts endpoint signing secrets. Back it up!
# WG_INGEST_PORT=8080                    # where your applications send events
# WG_ADMIN_PORT=8081                     # operator API (listens on 127.0.0.1 only; WG_ADMIN_BIND=0.0.0.0 to open it, not recommended)
# WG_INGEST_BIND=0.0.0.0                 # interface the event API listens on (127.0.0.1 when a reverse proxy runs on the same host)
# WG_RECEIVER_PORT=9000                  # demo receiver
# WG_ALLOW_INSECURE_HTTP=true            # allow http:// endpoint URLs (set false in production)
# WG_ALLOW_PRIVATE_NETWORKS=true         # allow endpoints on private networks (set false if customers choose URLs)
# WG_ENFORCE_QUOTA=false                 # reject events over the plan's monthly quota with 429
